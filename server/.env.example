# ─────────────────────────────────────────────────────────────
# CloudPMS Server — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Set to your deployed frontend origin in production, e.g.:
#   CLIENT_URL=https://cloudpms.kaifkhan.in
CLIENT_URL=http://localhost:5173

# ── MongoDB ───────────────────────────────────────────────────
# Get from MongoDB Atlas → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cloudpms?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────
# Generate strong secrets: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_ACCESS_SECRET=replace_with_64_byte_random_hex_access
JWT_REFRESH_SECRET=replace_with_64_byte_random_hex_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── AWS Region ────────────────────────────────────────────────
# Required in all environments. The AWS SDK resolves credentials via:
#   - Local dev  : AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars
#                  or ~/.aws/credentials (aws configure)
#   - EC2 prod   : IAM role attached to the instance (CloudPMS-EC2-Role)
#                  — no static key env vars needed on EC2.
AWS_REGION=ap-south-1

# ── AWS credentials (local development only) ─────────────────
# On EC2 with an attached IAM role, do NOT set these.
# The AWS SDK will automatically use the instance profile instead.
# Uncomment and fill in for local development only:
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key

# ── AWS S3 (Resume Storage) ───────────────────────────────────
AWS_S3_BUCKET_NAME=cloudpms-resumes

# ── AWS SES (Email Notifications) ────────────────────────────
# AWS_SES_SENDER_EMAIL must be a verified identity in SES (email or domain).
AWS_SES_SENDER_EMAIL=noreply@yourdomain.com
# AWS_SES_IDENTITY_ARN is only needed for cross-account SES sending authorization.
# Leave unset for normal same-account sending.
# AWS_SES_IDENTITY_ARN=arn:aws:ses:ap-south-1:123456789012:identity/yourdomain.com

# ── Bcrypt ───────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
